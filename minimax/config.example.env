# 复制为 .env 或直接 export；以下全部为占位值，不含任何真实凭据。

# --- MiniMax（必填） ---
MINIMAX_API_KEY=sk-REPLACE_WITH_YOUR_KEY
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# --- seekdb ---
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=
SEEKDB_DATABASE=minimax_ctx

# --- PowerContext 状态库（可重建） ---
CTXSDD_STATE_DB=./var/task_state.db

# --- 路径（一般不用改） ---
# CTXSDD_PROJECT=./demo_project
# CTXSDD_SPECS=./specs
# CTXSDD_RECORDS=./records
